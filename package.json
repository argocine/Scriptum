{
  "name": "scriptum",
  "productName": "Scriptum",
  "version": "1.1.1",
  "private": true,
  "description": "A free, professional screenwriting application with industry-standard formatting.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": {
    "name": "argocine",
    "email": "277909588+argocine@users.noreply.github.com"
  },
  "homepage": "https://github.com/argocine/Scriptum",
  "repository": {
    "type": "git",
    "url": "https://github.com/argocine/Scriptum.git"
  },
  "bugs": {
    "url": "https://github.com/argocine/Scriptum/issues"
  },
  "desktopName": "org.scriptum.app.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "node tools/prepare-dist.mjs && electron-builder --mac",
    "dist:all": "node tools/prepare-dist.mjs && electron-builder -mwl",
    "dist:ci": "node tools/prepare-dist.mjs && electron-builder --publish never",
    "verify:package": "node tools/verify-package.mjs",
    "test": "node test/security.test.mjs && node test/release-hardening.test.mjs && node test/model-ranges.test.mjs && node test/assistant.test.mjs && node test/alternates.test.mjs && node test/production.test.mjs && node test/snapshots.test.mjs && node test/story.test.mjs && node test/sprint.test.mjs && node test/table-read.test.mjs && node test/project.test.mjs && node test/format.test.mjs && node test/pdf.test.mjs && node test/unicode-pdf.test.mjs",
    "test:app": "node test/quit.test.mjs && node test/pdf-app.test.mjs"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "plist": "^5.0.0",
    "unzipper": "^0.12.5"
  },
  "build": {
    "appId": "org.scriptum.app",
    "productName": "Scriptum",
    "asar": true,
    "afterPack": "build/after-pack.cjs",
    "extraResources": [
      {
        "from": "build/electron-notices/ELECTRON-LICENSE.txt",
        "to": "licenses/ELECTRON-LICENSE.txt"
      },
      {
        "from": "build/electron-notices/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "src/assets/fonts/OFL-Noto.txt",
        "to": "licenses/OFL-Noto.txt"
      },
      {
        "from": "src/assets/fonts/OFL-Noto-CJK.txt",
        "to": "licenses/OFL-Noto-CJK.txt"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "scriptum",
        "name": "Scriptum Screenplay",
        "role": "Editor"
      },
      {
        "ext": "fountain",
        "name": "Fountain Screenplay",
        "role": "Editor"
      },
      {
        "ext": "spmd",
        "name": "Screenplain Markdown Screenplay",
        "role": "Editor"
      },
      {
        "ext": "fdx",
        "name": "Final Draft Document",
        "role": "Editor"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
