{
  "name": "scriptum",
  "productName": "Scriptum",
  "version": "1.0.0",
  "description": "A free, professional screenwriting application with industry-standard formatting.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Armando Gonzalez",
    "email": "277909588+argocine@users.noreply.github.com"
  },
  "homepage": "https://github.com/argocine/Scriptum",
  "repository": {
    "type": "git",
    "url": "https://github.com/argocine/Scriptum.git"
  },
  "bugs": {
    "url": "https://github.com/argocine/Scriptum/issues"
  },
  "desktopName": "org.scriptum.app.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --mac",
    "dist:all": "electron-builder -mwl",
    "test": "node test/security.test.mjs && node test/model-ranges.test.mjs && node test/assistant.test.mjs && node test/alternates.test.mjs && node test/production.test.mjs && node test/snapshots.test.mjs && node test/story.test.mjs && node test/sprint.test.mjs && node test/project.test.mjs && node test/format.test.mjs && node test/pdf.test.mjs",
    "test:app": "node test/quit.test.mjs"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.scriptum.app",
    "productName": "Scriptum",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "scriptum",
        "name": "Scriptum Screenplay",
        "role": "Editor"
      },
      {
        "ext": "fountain",
        "name": "Fountain Screenplay",
        "role": "Editor"
      },
      {
        "ext": "fdx",
        "name": "Final Draft Document",
        "role": "Editor"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
